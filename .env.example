# Optional. Leave these unset and ragebait uses the built-in chaos engine.
# If both keys are set, OpenAI is used. A provider error falls back to the chaos engine.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash
